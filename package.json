{
  "private": true,
  "name": "greenlight",
  "description": "Greenlight is a streaming application for Xbox and xCloud",
  "author": "amenefus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amenefus/greenlight.git"
  },
  "scripts": {
    "desktop": "yarn workspace greenlight-desktop",
    "desktopv3": "yarn workspace greenlight-desktop-v3",
    "docs": "yarn workspace @greenlight/docs",
    "logger": "yarn workspace @greenlight/logger",
    "platform": "yarn workspace @greenlight/platform",
    "playground": "yarn workspace @greenlight/platform-playground",
    "player": "yarn workspace @greenlight/player",
    "pages": "yarn workspace @greenlight/pages",
    "build:depsv3": "yarn logger build && yarn player build && yarn platform build",
    "build:pages": "yarn build:depsv3 && yarn pages build",
    "deploy:pages": "yarn pages deploy",
    "test:v3": "yarn logger test && yarn platform test"
  },
  "workspaces": [
    "packages/logger",
    "packages/player",
    "packages/pages",
    "packages/platform",
    "packages/platform-playground",
    "packages/desktop",
    "packages/desktop-v3",
    "packages/docs"
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "**/xal-node/npm": "^11.21.3",
    "**/tar": "^7.5.23",
    "**/sigstore": "^4.1.1",
    "**/@sigstore/core": "^3.2.1",
    "**/@sigstore/verify": "^3.1.1",
    "**/pacote": "^21.5.3",
    "**/fast-uri": "^3.1.9",
    "**/express-ws/ws": "^7.5.14",
    "**/ip-address": "^10.7.6",
    "**/postcss-selector-parser": "^7.2.1",
    "**/baseline-browser-mapping": "^2.11.39",
    "**/npm/**/minimatch": "^11.0.9",
    "**/npm/**/glob": "^14.0.6",
    "**/npm/**/undici": "^6.29.1",
    "**/node-gyp/undici": "^6.29.1",
    "**/@electron/get/undici": "^7.30.2",
    "**/rimraf/**/brace-expansion": "^1.1.22",
    "**/@eslint/eslintrc/**/brace-expansion": "^1.1.22",
    "**/@electron/asar/**/brace-expansion": "^1.1.22",
    "**/eslint-plugin-import/**/brace-expansion": "^1.1.22"
  }
}
