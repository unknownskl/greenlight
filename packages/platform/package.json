  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260518.1",
    "@trpc/server": "^11.11.0",
    "wrangler": "^4.92.0",
    "xal-node": "^1.1.6-beta2",
    "xbox-webapi": "2.0.0-beta4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "chai": "^6.2.1",
    "mocha": "^11.7.5",
    "ts-loader": "^9.5.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^7.2.3"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  }
