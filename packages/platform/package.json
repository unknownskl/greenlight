  "version": "0.1.0",
  "license": "MIT",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "start": "yarn build && node dist/index.js",
    "build": "yarn clean && tsc --build",
    "clean": "rm -rf dist/",
    "test": "yarn build && mocha tests/**.ts tests/**/*.ts",
